  // the rest of budotsmedia.com stays with the site's Worker budotsmedia-260818.
  // Deploy from this folder: ./build.sh && npx wrangler deploy (live at once). build.sh fills links from ../site/links.env.
  "name": "ghostinthemachine-index",
  "account_id": "1ddb1d70501c190c2bb95be0108aa771",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./_out", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "workers_dev": false,
  "routes": [
    { "pattern": "budotsmedia.com/ghostinthemachine", "zone_name": "budotsmedia.com" },
    { "pattern": "budotsmedia.com/ghostinthemachine/", "zone_name": "budotsmedia.com" },
    { "pattern": "budotsmedia.com/ghostinthemachine/media/*", "zone_name": "budotsmedia.com" },
    { "pattern": "www.budotsmedia.com/ghostinthemachine", "zone_name": "budotsmedia.com" },
    { "pattern": "www.budotsmedia.com/ghostinthemachine/", "zone_name": "budotsmedia.com" },
    { "pattern": "www.budotsmedia.com/ghostinthemachine/media/*", "zone_name": "budotsmedia.com" }
  ]
